# Vercel 生产环境配置（使用 Neon Postgres）
# 此文件仅为示例，实际环境变量在 Vercel 控制台配置
# 部署后，访问 /api/config/check 验证配置

# ⚠️ ⚠️ ⚠️ 重要提醒 ⚠️ ⚠️ ⚠️
# 以下值只是示例，必须在 Vercel 控制台设置为实际值
# 否则 OAuth 登录和数据库连接将失败

# SecondMe OAuth2 配置（必须更新）
SECONDME_CLIENT_ID=75fd5283-eefc-46fa-9d3b-8605690075ad
SECONDME_CLIENT_SECRET=your_secondme_client_secret_here  # 从 SecondMe 开发者控制台获取
# 重要：回调地址必须改为你的线上地址，与 SecondMe 控制台中配置的一致
SECONDME_REDIRECT_URI=https://your-project.vercel.app/api/auth/callback

# Neon Postgres 数据库（通过 Vercel Marketplace 集成后自动注入）
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname

# SecondMe API 端点（保持默认）
SECONDME_API_BASE_URL=https://api.mindverse.com/gate/lab
SECONDME_OAUTH_URL=https://go.second.me/oauth/
SECONDME_TOKEN_ENDPOINT=https://api.mindverse.com/gate/lab/api/oauth/token/code
SECONDME_REFRESH_ENDPOINT=https://api.mindverse.com/gate/lab/api/oauth/token/refresh

# 知乎开放平台 API 配置（可选）
ZHI_HU_API_BASE_URL=https://openapi.zhihu.com
ZHI_HU_APP_KEY=your_zhihu_app_key
ZHI_HU_APP_SECRET=your_zhihu_app_secret

# 注意：在Vercel中，大部分环境变量需要在控制台手动添加
# Neon 集成后会自动注入 DATABASE_URL 环境变量
# 敏感信息不要提交到代码仓库

# 🛠️ 配置验证清单
# 部署后检查以下事项：
#
# 1. SECONDME_REDIRECT_URI 是否正确？
#    - 必须是 HTTPS 协议
#    - 必须与 SecondMe 开发者控制台中配置的一致
#    - 不能包含 "localhost" 或 "your-project"
#
# 2. DATABASE_URL 是否设置？
#    - 应该由 Neon 自动注入
#    - 应该是 PostgreSQL 连接字符串
#    - 不能是本地地址 (localhost)
#
# 3. SECONDME_CLIENT_SECRET 是否正确？
#    - 不能是 "your_client_secret_here" 或示例值
#    - 必须从 SecondMe 开发者控制台获取
#
# 4. 验证方法：
#    - 访问 https://你的域名/api/config/check
#    - 查看配置状态和错误信息